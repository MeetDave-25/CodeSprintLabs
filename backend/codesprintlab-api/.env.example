APP_NAME="CodeSprint Labs API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Neon PostgreSQL Connection (Connection Pooler)
DB_CONNECTION=pgsql
DB_HOST=ep-green-base-b3tkxuoh-pooler.c-4.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=npg_kdDX2wa3uLWI
DB_SSLMODE=require
DB_NEON_ENDPOINT=ep-green-base-b3tkxuoh-pooler

# Frontend URL (for CORS)
FRONTEND_URL=https://codesprint-labs.vercel.app

# Laravel Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# File Storage
FILESYSTEM_DISK=public

# Mail Configuration (optional - for notifications)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@codesprintlabs.com"
MAIL_FROM_NAME="${APP_NAME}"

# UPI Payment Configuration (for manual course payments)
# Add your UPI ID and name for receiving payments
UPI_ID=yourname@paytm
UPI_NAME=CodeSprintLab

# Razorpay (for automated payments - optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (for file storage - resumes, documents)
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# JWT Secret (auto-generated with: php artisan jwt:secret)
JWT_SECRET=
